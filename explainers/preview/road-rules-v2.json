 "lines": [
  {
   "t": 0.3,
   "who": "narrator",
   "text": {
    "en": "Road safety. Six simple rules.",
    "hi": "सड़क सुरक्षा। छह आसान नियम।"
   }
  },
  {
   "t": 2.9,
   "who": "narrator",
   "text": {
    "en": "Ravi is walking to the crossing.",
    "hi": "रवि सड़क पार करने जा रहा है।"
   }
  },
  {
   "t": 5.6,
   "who": "narrator",
   "text": {
    "en": "Rule one: stop at the kerb.",
    "hi": "पहला नियम: किनारे पर रुकें।"
   }
  },
  {
   "t": 8.0,
   "who": "RAVI",
   "text": {
    "en": "I'll wait here.",
    "hi": "मैं यहीं रुकूँगा।"
   }
  },
  {
   "t": 11.4,
   "who": "narrator",
   "text": {
    "en": "Rule two: look left, right, then left again.",
    "hi": "दूसरा नियम: बाएँ, दाएँ, फिर बाएँ देखें।"
   }
  },
  {
   "t": 15.5,
   "who": "RAVI",
   "text": {
    "en": "All clear now.",
    "hi": "अब रास्ता साफ़ है।"
   }
  },
  {
   "t": 17.6,
   "who": "narrator",
   "text": {
    "en": "Rule three: cross only on walk.",
    "hi": "तीसरा नियम: वॉक दिखे, तभी पार करें।"
   }
  },
  {
   "t": 20.8,
   "who": "RAVI",
   "text": {
    "en": "Walk sign. Let's go!",
    "hi": "वॉक का निशान। चलो!"
   }
  },
  {
   "t": 28.2,
   "who": "narrator",
   "text": {
    "en": "Now Ravi is driving.",
    "hi": "अब रवि गाड़ी चला रहा है।"
   }
  },
  {
   "t": 30.7,
   "who": "narrator",
   "text": {
    "en": "Rule four: on red, stop at the line.",
    "hi": "चौथा नियम: लाल बत्ती पर लाइन पर रुकें।"
   }
  },
  {
   "t": 34.0,
   "who": "RAVI",
   "text": {
    "en": "Red light. I stop.",
    "hi": "लाल बत्ती। मैं रुकता हूँ।"
   }
  },
  {
   "t": 36.2,
   "who": "narrator",
   "text": {
    "en": "Rule five: seatbelt on, every trip.",
    "hi": "पाँचवाँ नियम: हर सफ़र में सीट बेल्ट लगाएँ।"
   }
  },
  {
   "t": 39.8,
   "who": "RAVI",
   "text": {
    "en": "Belt on. Click!",
    "hi": "बेल्ट लगा ली। क्लिक!"
   }
  },
  {
   "t": 41.9,
   "who": "narrator",
   "text": {
    "en": "Rule six: phone down while driving.",
    "hi": "छठा नियम: गाड़ी चलाते समय फ़ोन नहीं।"
   }
  },
  {
   "t": 45.3,
   "who": "RAVI",
   "text": {
    "en": "Calls can wait.",
    "hi": "कॉल रुक सकती है।"
   }
  },
  {
   "t": 47.1,
   "who": "narrator",
   "text": {
    "en": "Green means go. Drive calmly.",
    "hi": "हरी बत्ती पर आराम से चलें।"
   }
  },
  {
   "t": 50.0,
   "who": "narrator",
   "text": {
    "en": "Stop, look, buckle up. Stay alert, stay safe.",
    "hi": "रुकें, देखें, बेल्ट लगाएँ। सतर्क रहें, सुरक्षित रहें।"
   }
  }
 ]
}
