 "lines": [
  {
   "t": 0.3,
   "who": "narrator",
   "text": {
    "en": "Road safety. Six simple rules.",
    "hi": "सड़क सुरक्षा। छह आसान नियम।",
    "mr": "रस्ता सुरक्षा. सहा सोपे नियम.",
    "gu": "માર્ગ સલામતી. છ સરળ નિયમો."
   }
  },
  {
   "t": 3.9,
   "who": "narrator",
   "text": {
    "en": "Rule one: stop at the kerb.",
    "hi": "पहला नियम: किनारे पर रुकें।",
    "mr": "पहिला नियम: फुटपाथच्या कडेला थांबा.",
    "gu": "પહેલો નિયમ: ફૂટપાથની કિનારે થોભો."
   }
  },
  {
   "t": 7.0,
   "who": "RAVI",
   "text": {
    "en": "I'll wait here.",
    "hi": "मैं यहीं रुकूँगा।",
    "mr": "मी इथेच थांबतो.",
    "gu": "હું અહીં રાહ જોઈશ."
   },
   "bubble": true
  },
  {
   "t": 9.3,
   "who": "narrator",
   "text": {
    "en": "Rule two: look left, right, then left again.",
    "hi": "दूसरा नियम: बाएँ, दाएँ, फिर बाएँ देखें।",
    "mr": "दुसरा नियम: डावीकडे, उजवीकडे, मग पुन्हा डावीकडे पाहा.",
    "gu": "બીજો નિયમ: ડાબે, જમણે, પછી ફરી ડાબે જુઓ."
   }
  },
  {
   "t": 13.9,
   "who": "narrator",
   "text": {
    "en": "Rule three: cross only on walk.",
    "hi": "तीसरा नियम: वॉक दिखे, तभी पार करें।",
    "mr": "तिसरा नियम: वॉक दिसल्यावरच रस्ता ओलांडा.",
    "gu": "ત્રીજો નિયમ: વૉક દેખાય ત્યારે જ રસ્તો ઓળંગો."
   }
  },
  {
   "t": 17.5,
   "who": "RAVI",
   "text": {
    "en": "Green! Let's go.",
    "hi": "हरी बत्ती! चलो।",
    "mr": "हिरवा दिवा! चला.",
    "gu": "લીલી લાઇટ! ચાલો."
   },
   "bubble": true
  },
  {
   "t": 29.2,
   "who": "narrator",
   "text": {
    "en": "Rule four: on red, stop at the line.",
    "hi": "चौथा नियम: लाल पर, लाइन पर रुकें।",
    "mr": "चौथा नियम: लाल दिवा असताना रेषेवर थांबा.",
    "gu": "ચોથો નિયમ: લાલ લાઇટ હોય તો લાઇન પર થોભો."
   }
  },
  {
   "t": 33.4,
   "who": "narrator",
   "text": {
    "en": "Rule five: seatbelt on, every trip.",
    "hi": "पाँचवाँ नियम: हर बार सीट बेल्ट।",
    "mr": "पाचवा नियम: प्रत्येक प्रवासात सीट बेल्ट लावा.",
    "gu": "પાંચમો નિયમ: દરેક મુસાફરીમાં સીટ બેલ્ટ બાંધો."
   }
  },
  {
   "t": 37.6,
   "who": "RAVI",
   "text": {
    "en": "Belt on. Click!",
    "hi": "बेल्ट लगा ली। क्लिक!",
    "mr": "बेल्ट लावला. क्लिक!",
    "gu": "બેલ્ટ બાંધ્યો. ક્લિક!"
   },
   "bubble": true
  },
  {
   "t": 40.4,
   "who": "narrator",
   "text": {
    "en": "Rule six: phone down while driving.",
    "hi": "छठा नियम: गाड़ी चलाते समय फ़ोन नहीं।",
    "mr": "सहावा नियम: गाडी चालवताना फोन नको.",
    "gu": "છઠ્ઠો નિયમ: ગાડી ચલાવતી વખતે ફોન નહીં."
   }
  },
  {
   "t": 44.1,
   "who": "RAVI",
   "text": {
    "en": "Calls can wait.",
    "hi": "कॉल रुक सकती है।",
    "mr": "कॉल नंतर घेता येईल.",
