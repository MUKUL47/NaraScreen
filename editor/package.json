{
  "name": "narascreen-editor",
  "version": "1.0.0",
  "description": "NaraScreen visual timeline editor — Electron + React desktop app",
  "author": {
    "name": "Mukul Dutt"
  },
  "homepage": "https://github.com/mukuldutt/narascreen",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "bin": {
    "narascreen": "bin/narascreen"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "lint": "eslint .",
    "dist": "npm run build && npm run build:cli && node scripts/build-dist.js",
    "dist:linux": "npm run build && npm run build:cli && node scripts/build-dist.js --linux",
    "dist:mac": "npm run build && npm run build:cli && node scripts/build-dist.js --mac",
    "dist:win": "npm run build && npm run build:cli && node scripts/build-dist.js --win",
    "narascreen": "tsx api/cli.ts",
    "test:api": "tsx --test api/_tests/*.test.ts"
  },
  "build": {
    "appId": "com.narascreen.editor",
    "productName": "NaraScreen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-cli",
        "to": "dist-cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright-core",
        "to": "dist-cli/node_modules/playwright-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/linux/${arch}/ffprobe",
          "to": "bin/ffprobe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/darwin/${arch}/ffprobe",
          "to": "bin/ffprobe"
        }
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffprobe-static/bin/win32/${arch}/ffprobe.exe",
          "to": "bin/ffprobe.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "codemirror-json-schema": "^0.8.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.577.0",
    "playwright-core": "^1.61.0",
    "react": "^19.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "marked": "^16.4.2",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zod": "^4.6.5"
  }
}
